{
  "name": "collabspace-server",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:api": "tsx watch src/api.ts",
    "dev:collab": "tsx watch src/collab.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "start:api": "node dist/api.js",
    "start:collab": "node dist/collab.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "4.7.1",
    "@hocuspocus/provider": "^4.7.1",
    "@hocuspocus/server": "4.7.1",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.5",
    "nanoid": "5.0.9",
    "ws": "8.18.0",
    "y-protocols": "1.0.6",
    "yjs": "13.6.22",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.6",
    "@types/supertest": "6.0.2",
    "@types/ws": "8.5.13",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "eslint": "9.17.0",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}
