NODE_ENV=development

# Express REST API port
PORT=5000

# Hocuspocus WebSocket collaboration server port
COLLAB_PORT=1234

# MongoDB connection string (never commit real credentials)
MONGODB_URI=mongodb://localhost:27017/collabspace

# JWT secret — use a long, random string in production
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# User session token expiry (hours)
JWT_EXPIRY_HOURS=24

# Document-scoped WebSocket token expiry (seconds)
DOC_TOKEN_EXPIRY_SECONDS=3600

# Frontend origin for CORS
CLIENT_URL=http://localhost:5173
