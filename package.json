{
  "name": "collabspace-root",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time collaborative document editor — workspace root",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --names \"CLIENT,SERVER\" --prefix-colors \"cyan,blue\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:api": "npm run dev:api --workspace=server",
    "dev:collab": "npm run dev:collab --workspace=server",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "node server/dist/index.js",
    "start:api": "node server/dist/api.js",
    "start:collab": "node server/dist/collab.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --config=tests/playwright.config.ts",
    "lint": "npm run lint --workspace=client && npm run lint --workspace=server"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "@playwright/test": "1.49.1",
    "vitest": "2.1.9"
  }
}
